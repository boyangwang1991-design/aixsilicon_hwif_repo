CAPI=2:

name: aix:interface:credit_link:1.0.0
description: AIXSILICON credit link interface contract and views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_credit_link_pkg.sv
      - rtl/aix_credit_link_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/credit_link.interface.yaml: {copyto: metadata/credit_link.interface.yaml}
      - contract/credit_link_basic.profile.yaml: {copyto: metadata/credit_link_basic.profile.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
