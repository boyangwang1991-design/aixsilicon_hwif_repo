CAPI=2:

name: aix:interface:apb3:1.0.0
description: AIXSILICON AMBA APB3 interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_apb3_pkg.sv
      - rtl/aix_apb3_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/apb3.interface.yaml: {copyto: metadata/apb3.interface.yaml}
      - contract/apb3_base.profile.yaml: {copyto: metadata/apb3_base.profile.yaml}
      - doc/aix_apb3_interface.md: {copyto: metadata/aix_apb3_interface.md}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]