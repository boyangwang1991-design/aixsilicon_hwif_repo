CAPI=2:

name: aixsilicon:interface:i2c:0.1.0
description: AIXSILICON I2C interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/i2c_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/i2c.interface.yaml: {copyto: metadata/i2c.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
