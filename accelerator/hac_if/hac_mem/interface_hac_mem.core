CAPI=2:

name: aixsilicon:interface:hac_mem:0.1.0
description: AIXSILICON HAC-MEM system memory access interface contract and views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
      - aixsilicon:interface:hac_if:0.1.0
    files:
      - rtl/hac_mem_pkg.sv
      - rtl/hac_mem_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/hac_mem.interface.yaml: {copyto: metadata/hac_mem.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
