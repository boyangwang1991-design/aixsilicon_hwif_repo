CAPI=2:

name: aixsilicon:interface:spi:0.1.0
description: AIXSILICON SPI interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/spi_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/spi.interface.yaml: {copyto: metadata/spi.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
