CAPI=2:

name: aixsilicon:interface:req_ack:1.0.0
description: AIXSILICON request/acknowledge interface contract and views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/req_ack_pkg.sv
      - rtl/req_ack_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/req_ack.interface.yaml: {copyto: metadata/req_ack.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
