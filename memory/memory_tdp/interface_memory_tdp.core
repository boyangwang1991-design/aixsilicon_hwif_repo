CAPI=2:

name: aixsilicon:interface:memory_tdp:0.1.0
description: AIXSILICON true dual port memory interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/memory_tdp_pkg.sv
      - rtl/memory_tdp_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/memory_tdp.interface.yaml: {copyto: metadata/memory_tdp.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
