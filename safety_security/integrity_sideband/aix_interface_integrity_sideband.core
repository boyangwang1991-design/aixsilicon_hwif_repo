CAPI=2:

name: aix:interface:integrity_sideband:0.1.0
description: AIXSILICON integrity sideband interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_integrity_sideband_pkg.sv
      - rtl/aix_integrity_sideband_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/integrity_sideband.interface.yaml: {copyto: metadata/integrity_sideband.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
