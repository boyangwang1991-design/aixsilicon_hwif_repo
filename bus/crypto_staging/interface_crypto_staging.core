CAPI=2:

name: aixsilicon:interface:crypto_staging:0.2.0
description: 'CCS crypto_staging: contract-derived passive SV views'
filesets:
  rtl:
    files:
    - rtl/aix_crypto_staging_pkg.sv
    - rtl/aix_crypto_staging_if.sv
    - rtl/aix_crypto_staging_flat_wrapper.sv
    file_type: systemVerilogSource
  contract:
    files:
    - contract/crypto_staging.interface.yaml
    - contract/crypto_staging_base.profile.yaml
    file_type: user
  smoke:
    files:
    - tests/tb_crypto_staging.sv
    file_type: systemVerilogSource
targets:
  default:
    filesets:
    - rtl
  contract:
    filesets:
    - contract
  compile_smoke:
    default_tool: vcs
    filesets:
    - rtl
    - smoke
    toplevel: tb_crypto_staging
    tools:
      vcs:
        vcs_options:
        - -full64
        - -sverilog
        - -timescale=1ns/1ps
        - +lint=all
