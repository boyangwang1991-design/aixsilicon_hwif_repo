CAPI=2:

name: aix:interface:status_control:0.1.0
description: AIXSILICON status/control interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_status_control_pkg.sv
      - rtl/aix_status_control_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/status_control.interface.yaml: {copyto: metadata/status_control.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
