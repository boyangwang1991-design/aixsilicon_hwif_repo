CAPI=2:

name: aixsilicon:interface:watchdog_service:0.1.0
description: AIXSILICON watchdog service interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/watchdog_service_pkg.sv
      - rtl/watchdog_service_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/watchdog_service.interface.yaml: {copyto: metadata/watchdog_service.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
