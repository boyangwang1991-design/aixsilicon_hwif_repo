CAPI=2:

name: aix:interface:ready_valid:1.0.0
description: AIXSILICON ready/valid stream interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_ready_valid_pkg.sv
      - rtl/aix_ready_valid_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/ready_valid.interface.yaml: {copyto: metadata/ready_valid.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
