CAPI=2:

name: aixsilicon:interface:uart:0.1.0
description: AIXSILICON UART interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/uart_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/uart.interface.yaml: {copyto: metadata/uart.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
