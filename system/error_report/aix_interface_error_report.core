CAPI=2:

name: aix:interface:error_report:1.0.0
description: AIXSILICON error report interface contract and views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_error_report_pkg.sv
      - rtl/aix_error_report_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/error_report.interface.yaml: {copyto: metadata/error_report.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
