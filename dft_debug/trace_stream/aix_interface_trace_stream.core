CAPI=2:

name: aix:interface:trace_stream:0.1.0
description: AIXSILICON trace stream interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_trace_stream_pkg.sv
      - rtl/aix_trace_stream_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/trace_stream.interface.yaml: {copyto: metadata/trace_stream.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
