CAPI=2:

name: aixsilicon:interface:gpio:0.1.0
description: AIXSILICON GPIO interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/gpio_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/gpio.interface.yaml: {copyto: metadata/gpio.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
