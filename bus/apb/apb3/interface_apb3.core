CAPI=2:

name: aixsilicon:interface:apb3:1.0.0
description: AIXSILICON AMBA APB3 interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/apb3_pkg.sv
      - rtl/apb3_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/apb3.interface.yaml: {copyto: metadata/apb3.interface.yaml}
      - contract/apb3_base.profile.yaml: {copyto: metadata/apb3_base.profile.yaml}
      - doc/apb3_interface.md: {copyto: metadata/apb3_interface.md}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]