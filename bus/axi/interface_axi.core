CAPI=2:

name: aixsilicon:interface:axi:1.0.0
description: AIXSILICON AXI4 interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/axi_pkg.sv
      - rtl/axi_if.sv
      - rtl/axi_flat_wrapper.sv
    file_type: systemVerilogSource

  include:
    files:
      - rtl/axi_typedef.svh:
          is_include_file: true
      - rtl/axi_assign.svh:
          is_include_file: true
    file_type: systemVerilogSource

  contract:
    files:
      - contract/axi.interface.yaml: {copyto: metadata/axi.interface.yaml}
      - contract/axi4_base.profile.yaml: {copyto: metadata/axi4_base.profile.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl, include]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl, include]
