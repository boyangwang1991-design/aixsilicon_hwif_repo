CAPI=2:

name: aix:interface:noc_flit:0.1.0
description: AIXSILICON NoC flit interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_noc_flit_pkg.sv
      - rtl/aix_noc_flit_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/noc_flit.interface.yaml: {copyto: metadata/noc_flit.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
