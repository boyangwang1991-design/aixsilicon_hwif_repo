CAPI=2:

name: aixsilicon:interface:crypto_mac_call:0.1.0
description: 'CCS crypto_mac_call: contract-derived passive SV views'
filesets:
  rtl:
    files:
    - rtl/aix_crypto_mac_call_pkg.sv
    - rtl/aix_crypto_mac_call_if.sv
    - rtl/aix_crypto_mac_call_flat_wrapper.sv
    file_type: systemVerilogSource
  contract:
    files:
    - contract/crypto_mac_call.interface.yaml
    - contract/crypto_mac_call_sha2.profile.yaml
    file_type: user
  smoke:
    files:
    - tests/tb_crypto_mac_call.sv
    file_type: systemVerilogSource
targets:
  default:
    filesets:
    - rtl
  contract:
    filesets:
    - contract
  compile_smoke:
    default_tool: vcs
    filesets:
    - rtl
    - smoke
    toplevel: tb_crypto_mac_call
    tools:
      vcs:
        vcs_options:
        - -full64
        - -sverilog
        - -timescale=1ns/1ps
        - +lint=all
