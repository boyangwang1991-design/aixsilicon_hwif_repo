CAPI=2:

name: aix:interface:reg_native:1.0.0
description: AIXSILICON native register interface contract and views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_reg_native_pkg.sv
      - rtl/aix_reg_native_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/reg_native.interface.yaml: {copyto: metadata/reg_native.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
