CAPI=2:

name: aix:interface:cache_maintenance:0.1.0
description: AIXSILICON cache maintenance interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_cache_maintenance_pkg.sv
      - rtl/aix_cache_maintenance_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/cache_maintenance.interface.yaml: {copyto: metadata/cache_maintenance.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
