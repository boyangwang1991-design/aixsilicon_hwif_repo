CAPI=2:

name: aixsilicon:interface:packet_stream:1.0.0
description: AIXSILICON packet stream interface contract and views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/packet_stream_pkg.sv
      - rtl/packet_stream_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/packet_stream.interface.yaml: {copyto: metadata/packet_stream.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
