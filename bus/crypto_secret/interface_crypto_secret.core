CAPI=2:

name: aixsilicon:interface:crypto_secret:0.2.0
description: 'CCS crypto_secret: contract-derived passive SV views'
filesets:
  rtl:
    files:
    - rtl/aix_crypto_secret_pkg.sv
    - rtl/aix_crypto_secret_if.sv
    - rtl/aix_crypto_secret_flat_wrapper.sv
    file_type: systemVerilogSource
  contract:
    files:
    - contract/crypto_secret.interface.yaml
    - contract/crypto_secret_base.profile.yaml
    file_type: user
  smoke:
    files:
    - tests/tb_crypto_secret.sv
    file_type: systemVerilogSource
targets:
  default:
    filesets:
    - rtl
  contract:
    filesets:
    - contract
  compile_smoke:
    default_tool: vcs
    filesets:
    - rtl
    - smoke
    toplevel: tb_crypto_secret
    tools:
      vcs:
        vcs_options:
        - -full64
        - -sverilog
        - -timescale=1ns/1ps
        - +lint=all
