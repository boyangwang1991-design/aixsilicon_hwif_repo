CAPI=2:

name: aix:interface:performance_event:0.1.0
description: AIXSILICON performance event interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_performance_event_pkg.sv
      - rtl/aix_performance_event_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/performance_event.interface.yaml: {copyto: metadata/performance_event.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
