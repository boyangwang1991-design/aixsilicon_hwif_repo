CAPI=2:

name: aix:interface:reset:1.0.0
description: AIXSILICON reset interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_reset_pkg.sv
      - rtl/aix_reset_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/reset.interface.yaml: {copyto: metadata/reset.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
