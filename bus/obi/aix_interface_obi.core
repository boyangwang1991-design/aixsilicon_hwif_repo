CAPI=2:

name: aix:interface:obi:0.1.0
description: AIXSILICON RISC-V OBI interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_obi_pkg.sv
      - rtl/aix_obi_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/obi.interface.yaml: {copyto: metadata/obi.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
