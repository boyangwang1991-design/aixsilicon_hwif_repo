CAPI=2:

name: aix:interface:hac_event:0.1.0
description: AIXSILICON HAC-EVENT event interface contract and views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
      - aix:interface:hac_if:0.1.0
    files:
      - rtl/aix_hac_event_pkg.sv
      - rtl/aix_hac_event_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/hac_event.interface.yaml: {copyto: metadata/hac_event.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
