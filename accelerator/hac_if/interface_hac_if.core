CAPI=2:

name: aixsilicon:interface:hac_if:1.0.0
description: HAC 1.0 draft aggregate, six independent contract families
filesets:
  rtl:
    depend:
    - aixsilicon:interface:hac_ctrl:1.0.0
    - aixsilicon:interface:hac_event:1.0.0
    - aixsilicon:interface:hac_lmem:1.0.0
    - aixsilicon:interface:hac_mem:1.0.0
    - aixsilicon:interface:hac_mgmt:1.0.0
    - aixsilicon:interface:hac_stream:1.0.0
  contract:
    files:
    - hac_ctrl/contract/hac_ctrl.interface.yaml
    - hac_event/contract/hac_event.interface.yaml
    - hac_lmem/contract/hac_lmem.interface.yaml
    - hac_mem/contract/hac_mem.interface.yaml
    - hac_mgmt/contract/hac_mgmt.interface.yaml
    - hac_stream/contract/hac_stream.interface.yaml
    - contract/hac_p0.profile.yaml
    - contract/hac_p1.profile.yaml
    - contract/hac_p2.profile.yaml
    - hac_stream/contract/hac_stream_axis.binding.yaml
    file_type: user
  spec:
    files:
    - spec/hac_if_spec.md
    - spec/migration_1.0.md
