CAPI=2:

name: aixsilicon:interface:fault_injection_control:0.1.0
description: AIXSILICON fault injection control interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/fault_injection_control_pkg.sv
      - rtl/fault_injection_control_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/fault_injection_control.interface.yaml: {copyto: metadata/fault_injection_control.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
