CAPI=2:

name: aix:interface:retention:0.1.0
description: AIXSILICON retention interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_retention_pkg.sv
      - rtl/aix_retention_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/retention.interface.yaml: {copyto: metadata/retention.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
