CAPI=2:

name: aixsilicon:interface:rom:0.1.0
description: AIXSILICON ROM interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/rom_pkg.sv
      - rtl/rom_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/rom.interface.yaml: {copyto: metadata/rom.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
