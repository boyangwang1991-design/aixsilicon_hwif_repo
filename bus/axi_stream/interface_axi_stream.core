CAPI=2:

name: aixsilicon:interface:axi_stream:1.0.0
description: AIXSILICON AXI-Stream interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/axi_stream_pkg.sv
      - rtl/axi_stream_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/axi_stream.interface.yaml: {copyto: metadata/axi_stream.interface.yaml}
      - contract/axi_stream_packet.profile.yaml: {copyto: metadata/axi_stream_packet.profile.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
