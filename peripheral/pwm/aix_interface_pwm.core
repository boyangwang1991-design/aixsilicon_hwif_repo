CAPI=2:

name: aix:interface:pwm:0.1.0
description: AIXSILICON PWM interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aix:interface:common:1.0.0
    files:
      - rtl/aix_pwm_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/pwm.interface.yaml: {copyto: metadata/pwm.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
