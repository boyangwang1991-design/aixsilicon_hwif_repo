CAPI=2:

name: aixsilicon:interface:power_state:0.1.0
description: AIXSILICON power state interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/power_state_pkg.sv
      - rtl/power_state_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/power_state.interface.yaml: {copyto: metadata/power_state.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
