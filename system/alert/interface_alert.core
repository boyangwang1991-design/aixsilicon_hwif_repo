CAPI=2:

name: aixsilicon:interface:alert:0.1.0
description: AIXSILICON alert interface contract and SystemVerilog views

filesets:
  rtl:
    depend:
      - aixsilicon:interface:common:1.0.0
    files:
      - rtl/alert_pkg.sv
      - rtl/alert_if.sv
    file_type: systemVerilogSource

  contract:
    files:
      - contract/alert.interface.yaml: {copyto: metadata/alert.interface.yaml}
    file_type: user

targets:
  default:
    filesets: [rtl]

  contract:
    filesets: [contract]

  lint:
    filesets: [rtl]
